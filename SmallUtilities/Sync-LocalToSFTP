<#
.SYNOPSIS
    Scanner -> Processing -> SFTP -> Archive transfer pipeline.

.DESCRIPTION
    Files arrive beneath:
        Scanner\Incoming

    The relative directory structure beneath Incoming is authoritative and
    is mirrored to:
        Scanner\Processing
        SFTP RemoteRoot
        Scanner\Archive

    Example:
        Incoming\Dept A\2026\My Scan.pdf

    becomes:
        Processing\Dept A\2026\My Scan.pdf
        /incoming/Dept A/2026/My Scan.pdf
        Archive\Dept A\2026\My Scan.pdf

    FILE READINESS:
        A file is only claimed from Incoming when:
          - It has not been modified for MinimumFileAgeSeconds.
          - It can be opened exclusively.
          - It meets MinimumFileSizeBytes.

    DUPLICATES:
        Original filenames are preserved unless a collision is found.

        Example:
            File.pdf

        If already present:
            File_20260918_121530247.pdf

        If that timestamp somehow also collides:
            File_20260918_121530247_001.pdf

        Once renamed, the new relative path is preserved through:
            Processing -> SFTP -> Archive

    RETRIES:
        Failed uploads remain in Processing and are retried on the next run.

    UPLOAD STATE:
        State files prevent an already-successful SFTP upload from being
        uploaded again if the subsequent Processing -> Archive move fails.

    LOGGING:
        ScannerTransfer-yyyy-MM-dd.log
        WinSCP-yyyy-MM-dd.log

    CLEANUP:
        Archive files and logs older than CleanupDays are removed.

    Designed for:
        Windows PowerShell 5.1+
        PowerShell 7+
        WinSCP.com
#>


# =============================================================================
# CONFIGURATION
# =============================================================================

# Root scanner folder.
#
# If this script runs on the server hosting the share, prefer the local path
# rather than accessing the server through its own SMB share.
$ScannerRoot = "D:\Scanner"


# WinSCP console executable.
$WinSCPPath = "C:\Program Files (x86)\WinSCP\WinSCP.com"


# WinSCP INI containing the saved SFTP connection.
$WinSCPIniPath = "C:\Scanner\Config\WinSCP.ini"


# Exact saved session name from WinSCP Site Manager.
$WinSCPSiteName = "Scanner SFTP"


# SFTP root corresponding to Scanner\Incoming.
#
# Example:
#   Incoming\Dept A\File.pdf
#
# becomes:
#   /incoming/Dept A/File.pdf
$RemoteRoot = "/incoming"


# Retention period for:
#   Archive files
#   PowerShell logs
#   WinSCP logs
$CleanupDays = 30


# Files younger than this remain in Incoming.
#
# This protects against scanner software that temporarily closes/reopens
# a file while producing it.
$MinimumFileAgeSeconds = 60


# Set to 0 if zero-byte files are legitimate.
$MinimumFileSizeBytes = 1


# Examples:
#   "*"       = all files
#   "*.pdf"   = PDF only
$FileFilter = "*"


# If true, empty Incoming directories are also mirrored to:
#   Processing
#   Archive
#   SFTP
$MirrorEmptyDirectories = $true


# Detailed WinSCP logging.
$EnableWinSCPProtocolLog = $true


# WinSCP log verbosity.
#
# 0 = normal
# 1 = debug 1
#
# Debug 1 is useful while troubleshooting WinSCP command quoting.
$WinSCPLogLevel = 0


# =============================================================================
# DERIVED PATHS
# =============================================================================

$IncomingDir   = Join-Path $ScannerRoot "Incoming"
$ProcessingDir = Join-Path $ScannerRoot "Processing"
$ArchiveDir    = Join-Path $ScannerRoot "Archive"
$LogDir        = Join-Path $ScannerRoot "Logs"

# Internal state used to distinguish:
#
#   "needs uploading"
#
# from:
#
#   "already uploaded, but Archive move failed"
#
$StateDir = Join-Path $ScannerRoot "_TransferState"


# Used to prevent overlapping scheduled runs.
$LockFile = Join-Path $ScannerRoot ".ScannerTransfer.lock"


# Cache remote directories already verified during this execution.
$script:VerifiedRemoteDirectories = @{}


# PowerShell 7.3+ changed native command argument handling.
# Legacy handling is preferable for the WinSCP /command quoting style.
if ($PSVersionTable.PSVersion.Major -ge 7) {
    $PSNativeCommandArgumentPassing = "Legacy"
}


# =============================================================================
# LOGGING
# =============================================================================

function Write-Log {
    param (
        [Parameter(Mandatory)]
        [string]$Message,

        [ValidateSet("INFO", "WARN", "ERROR")]
        [string]$Level = "INFO"
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss.fff"
    $date      = Get-Date -Format "yyyy-MM-dd"

    $logFile = Join-Path `
        $LogDir `
        "ScannerTransfer-$date.log"

    $line = "$timestamp [$Level] $Message"

    Add-Content `
        -LiteralPath $logFile `
        -Value $line `
        -Encoding UTF8
}


# =============================================================================
# LOCAL PATH HELPERS
# =============================================================================

function Ensure-LocalDirectory {
    param (
        [Parameter(Mandatory)]
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path -PathType Container)) {

        New-Item `
            -ItemType Directory `
            -Path $Path `
            -Force `
            -ErrorAction Stop |
        Out-Null
    }
}


function Ensure-LocalParentDirectory {
    param (
        [Parameter(Mandatory)]
        [string]$Path
    )

    $parent = Split-Path `
        -Parent `
        $Path

    if (-not [string]::IsNullOrWhiteSpace($parent)) {
        Ensure-LocalDirectory -Path $parent
    }
}


function Get-RelativePath {
    param (
        [Parameter(Mandatory)]
        [string]$FullPath,

        [Parameter(Mandatory)]
        [string]$BasePath
    )

    $base = (
        [System.IO.Path]::GetFullPath($BasePath)
    ).TrimEnd('\') + '\'

    $full = [System.IO.Path]::GetFullPath($FullPath)

    if (-not $full.StartsWith(
        $base,
        [System.StringComparison]::OrdinalIgnoreCase
    )) {
        throw "Path '$FullPath' is not underneath '$BasePath'."
    }

    return $full.Substring($base.Length)
}


# =============================================================================
# DUPLICATE NAME HANDLING
# =============================================================================

function New-DuplicateRelativePath {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath,

        [Parameter(Mandatory)]
        [string]$Timestamp,

        [int]$Attempt = 0
    )

    $directory = Split-Path `
        -Parent `
        $RelativePath

    $fileName = Split-Path `
        -Leaf `
        $RelativePath

    $baseName = [System.IO.Path]::GetFileNameWithoutExtension(
        $fileName
    )

    $extension = [System.IO.Path]::GetExtension(
        $fileName
    )

    if ($Attempt -eq 0) {

        $newFileName = "${baseName}_${Timestamp}${extension}"
    }
    else {

        $counter = "{0:D3}" -f $Attempt

        $newFileName =
            "${baseName}_${Timestamp}_${counter}${extension}"
    }

    if ([string]::IsNullOrWhiteSpace($directory)) {
        return $newFileName
    }

    return Join-Path `
        $directory `
        $newFileName
}


# =============================================================================
# FILE READINESS
# =============================================================================

function Test-FileReady {
    param (
        [Parameter(Mandatory)]
        [System.IO.FileInfo]$File
    )

    try {
        $File.Refresh()
    }
    catch {
        return $false
    }


    # -------------------------------------------------------------------------
    # Age check
    # -------------------------------------------------------------------------

    $ageSeconds = (
        [DateTime]::UtcNow - $File.LastWriteTimeUtc
    ).TotalSeconds

    if ($ageSeconds -lt $MinimumFileAgeSeconds) {
        return $false
    }


    # -------------------------------------------------------------------------
    # Size check
    # -------------------------------------------------------------------------

    if ($File.Length -lt $MinimumFileSizeBytes) {
        return $false
    }


    # -------------------------------------------------------------------------
    # Exclusive access check
    # -------------------------------------------------------------------------

    $stream = $null

    try {

        $stream = New-Object System.IO.FileStream(
            $File.FullName,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Read,
            [System.IO.FileShare]::None
        )

        return $true
    }
    catch {

        return $false
    }
    finally {

        if ($null -ne $stream) {
            $stream.Dispose()
        }
    }
}


# =============================================================================
# REMOTE PATH HELPERS
# =============================================================================

function Get-RemotePath {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath
    )

    $root = $RemoteRoot.TrimEnd('/')

    if ([string]::IsNullOrWhiteSpace($root)) {
        $root = "/"
    }

    $relativeRemote = $RelativePath.Replace('\', '/').TrimStart('/')

    if ([string]::IsNullOrWhiteSpace($relativeRemote)) {
        return $root
    }

    if ($root -eq "/") {
        return "/$relativeRemote"
    }

    return "$root/$relativeRemote"
}


function Get-RemoteParentPath {
    param (
        [Parameter(Mandatory)]
        [string]$RemotePath
    )

    $index = $RemotePath.LastIndexOf('/')

    if ($index -le 0) {
        return "/"
    }

    return $RemotePath.Substring(
        0,
        $index
    )
}


# =============================================================================
# WINSCP /COMMAND QUOTING
# =============================================================================

function ConvertTo-WinSCPCommandArgument {
    param (
        [Parameter(Mandatory)]
        [string]$Value
    )

    <#
        WinSCP /command requires quotes inside an individual command-line
        command to be doubled.

        Example input:

            D:\Scanner\Processing\Dept A\My Scan.pdf

        Returns:

            ""D:\Scanner\Processing\Dept A\My Scan.pdf""

        PowerShell then passes the complete command to WinSCP as one argument.

        This allows WinSCP to ultimately interpret:

            put "D:\Scanner\Processing\Dept A\My Scan.pdf" "/incoming/Dept A/My Scan.pdf"
    #>

    $escapedValue = $Value.Replace(
        '"',
        '""'
    )

    return '""' + $escapedValue + '""'
}


# =============================================================================
# WINSCP EXECUTION
# =============================================================================

function Invoke-WinSCP {
    param (
        [Parameter(Mandatory)]
        [string[]]$Commands
    )

    $date = Get-Date -Format "yyyy-MM-dd"


    # -------------------------------------------------------------------------
    # Base executable arguments
    # -------------------------------------------------------------------------

    $arguments = @(
        "/ini=$WinSCPIniPath"
    )


    # -------------------------------------------------------------------------
    # Optional protocol log
    # -------------------------------------------------------------------------

    if ($EnableWinSCPProtocolLog) {

        $winSCPLog = Join-Path `
            $LogDir `
            "WinSCP-$date.log"

        $arguments += "/log=$winSCPLog"
        $arguments += "/loglevel=$WinSCPLogLevel"

        # Append each invocation to today's WinSCP logfile.
        $arguments += "/rawconfig"
        $arguments += "Logging\LogFileAppend=on"
    }


    # -------------------------------------------------------------------------
    # Embedded commands
    # -------------------------------------------------------------------------

    $arguments += "/command"
    $arguments += $Commands


    # -------------------------------------------------------------------------
    # Run WinSCP
    # -------------------------------------------------------------------------

    try {

        $output = & $WinSCPPath @arguments 2>&1
        $exitCode = $LASTEXITCODE
    }
    catch {

        return [PSCustomObject]@{
            ExitCode = -1
            Output   = @(
                $_.Exception.Message
            )
        }
    }

    return [PSCustomObject]@{
        ExitCode = $exitCode
        Output   = @($output)
    }
}


function Get-WinSCPBaseCommands {

    $quotedSiteName = $WinSCPSiteName

    return @(
        "option batch abort"
        "open $quotedSiteName"
    )
}


# =============================================================================
# REMOTE DIRECTORY HANDLING
# =============================================================================

function Ensure-RemoteDirectory {
    param (
        [Parameter(Mandatory)]
        [string]$RemoteDirectory
    )

    $normalized = $RemoteDirectory.TrimEnd('/')

    if ([string]::IsNullOrWhiteSpace($normalized)) {
        $normalized = "/"
    }

    if ($normalized -eq "/") {
        return
    }

    if (-not $normalized.StartsWith("/")) {
        throw "Remote directory must be absolute: '$RemoteDirectory'"
    }


    # -------------------------------------------------------------------------
    # Build one level at a time.
    # -------------------------------------------------------------------------

    $segments = $normalized.Trim('/').Split('/')

    $current = ""

    foreach ($segment in $segments) {

        if ([string]::IsNullOrWhiteSpace($segment)) {
            continue
        }

        $current = "$current/$segment"


        # Already verified during this run.
        if ($script:VerifiedRemoteDirectories.ContainsKey($current)) {
            continue
        }


        $quotedCurrent =
            ConvertTo-WinSCPCommandArgument `
                -Value $current


        # ---------------------------------------------------------------------
        # Does it already exist?
        # ---------------------------------------------------------------------

        $commands = Get-WinSCPBaseCommands

        $commands += "stat $quotedCurrent"
        $commands += "exit"

        $result = Invoke-WinSCP `
            -Commands $commands


        if ($result.ExitCode -ne 0) {

            # -----------------------------------------------------------------
            # Try creating it.
            # -----------------------------------------------------------------

            $commands = Get-WinSCPBaseCommands

            $commands += "mkdir $quotedCurrent"
            $commands += "exit"

            $null = Invoke-WinSCP `
                -Commands $commands


            # -----------------------------------------------------------------
            # Verify it now exists.
            #
            # This also handles a race where another process created the
            # directory after our first stat.
            # -----------------------------------------------------------------

            $commands = Get-WinSCPBaseCommands

            $commands += "stat $quotedCurrent"
            $commands += "exit"

            $verifyResult = Invoke-WinSCP `
                -Commands $commands

            if ($verifyResult.ExitCode -ne 0) {

                throw (
                    "Unable to create or verify remote directory " +
                    "'$current'."
                )
            }
        }


        $script:VerifiedRemoteDirectories[$current] = $true
    }
}


# =============================================================================
# REMOTE FILE EXISTENCE
# =============================================================================

function Test-RemoteFileExists {
    param (
        [Parameter(Mandatory)]
        [string]$RemoteFilePath
    )

    $quotedRemoteFile =
        ConvertTo-WinSCPCommandArgument `
            -Value $RemoteFilePath


    # -------------------------------------------------------------------------
    # Check requested file.
    # -------------------------------------------------------------------------

    $commands = Get-WinSCPBaseCommands

    $commands += "stat $quotedRemoteFile"
    $commands += "exit"

    $result = Invoke-WinSCP `
        -Commands $commands


    if ($result.ExitCode -eq 0) {
        return $true
    }


    # -------------------------------------------------------------------------
    # stat also fails if SFTP itself is unavailable.
    #
    # Verify the parent so we can distinguish:
    #
    #   file does not exist
    #
    # from:
    #
    #   SFTP connection/path unavailable
    # -------------------------------------------------------------------------

    $remoteParent = Get-RemoteParentPath `
        -RemotePath $RemoteFilePath

    $quotedRemoteParent =
        ConvertTo-WinSCPCommandArgument `
            -Value $remoteParent

    $commands = Get-WinSCPBaseCommands

    $commands += "stat $quotedRemoteParent"
    $commands += "exit"

    $parentResult = Invoke-WinSCP `
        -Commands $commands


    if ($parentResult.ExitCode -eq 0) {
        return $false
    }


    throw (
        "Could not verify remote path '$RemoteFilePath'. " +
        "The SFTP connection or remote parent directory is unavailable."
    )
}


# =============================================================================
# UPLOAD STATE
# =============================================================================

function Get-StatePath {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath
    )

    return Join-Path `
        $StateDir `
        ($RelativePath + ".uploadstate.json")
}


function Get-UploadState {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath
    )

    $statePath = Get-StatePath `
        -RelativePath $RelativePath


    if (-not (Test-Path -LiteralPath $statePath -PathType Leaf)) {
        return $null
    }


    try {

        return (
            Get-Content `
                -LiteralPath $statePath `
                -Raw `
                -ErrorAction Stop |
            ConvertFrom-Json
        )
    }
    catch {

        throw (
            "Unable to read transfer state '$statePath': " +
            $_.Exception.Message
        )
    }
}


function Set-UploadState {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath,

        [Parameter(Mandatory)]
        [ValidateSet("Uploading", "Uploaded")]
        [string]$Status,

        [Parameter(Mandatory)]
        [string]$RemotePath
    )

    $statePath = Get-StatePath `
        -RelativePath $RelativePath

    Ensure-LocalParentDirectory `
        -Path $statePath


    $state = [PSCustomObject]@{
        RelativePath = $RelativePath
        RemotePath   = $RemotePath
        Status       = $Status
        UpdatedUtc   = [DateTime]::UtcNow.ToString("o")
    }


    $state |
        ConvertTo-Json |
        Set-Content `
            -LiteralPath $statePath `
            -Encoding UTF8 `
            -Force `
            -ErrorAction Stop
}


function Remove-UploadState {
    param (
        [Parameter(Mandatory)]
        [string]$RelativePath
    )

    $statePath = Get-StatePath `
        -RelativePath $RelativePath


    if (Test-Path -LiteralPath $statePath) {

        Remove-Item `
            -LiteralPath $statePath `
            -Force `
            -ErrorAction SilentlyContinue
    }
}


# =============================================================================
# SFTP UPLOAD
# =============================================================================

function Send-SftpFile {
    param (
        [Parameter(Mandatory)]
        [string]$LocalPath,

        [Parameter(Mandatory)]
        [string]$RemotePath
    )


    # -------------------------------------------------------------------------
    # Correct /command quoting.
    #
    # These become:
    #
    #   ""D:\Path With Spaces\File.pdf""
    #
    # rather than:
    #
    #   "D:\Path With Spaces\File.pdf"
    #
    # because they are embedded inside a WinSCP /command argument.
    # -------------------------------------------------------------------------

    $quotedSiteName =
        ConvertTo-WinSCPCommandArgument `
            -Value $WinSCPSiteName

    $quotedLocalPath =
        ConvertTo-WinSCPCommandArgument `
            -Value $LocalPath

    $quotedRemotePath =
        ConvertTo-WinSCPCommandArgument `
            -Value $RemotePath


    $commands = @(
        "option batch abort"

        # Leave confirmation enabled so an unexpected collision between
        # our existence check and PUT fails instead of silently overwriting.
        "option confirm on"

        "open $quotedSiteName"

        "put -resumesupport=on $quotedLocalPath $quotedRemotePath"

        "exit"
    )


    $result = Invoke-WinSCP `
        -Commands $commands


    if ($result.ExitCode -eq 0) {
        return $true
    }


    Write-Log `
        "SFTP upload failed: '$LocalPath' -> '$RemotePath'." `
        -Level "ERROR"


    foreach ($line in $result.Output) {

        if (-not [string]::IsNullOrWhiteSpace(
            [string]$line
        )) {
            Write-Log `
                "WinSCP: $line" `
                -Level "ERROR"
        }
    }


    return $false
}


# =============================================================================
# MIRROR LOCAL DIRECTORY STRUCTURE
# =============================================================================

function Mirror-LocalDirectoryStructure {

    $directories = Get-ChildItem `
        -LiteralPath $IncomingDir `
        -Directory `
        -Recurse `
        -ErrorAction Stop


    foreach ($directory in $directories) {

        $relative = Get-RelativePath `
            -FullPath $directory.FullName `
            -BasePath $IncomingDir


        Ensure-LocalDirectory `
            -Path (
                Join-Path `
                    $ProcessingDir `
                    $relative
            )


        Ensure-LocalDirectory `
            -Path (
                Join-Path `
                    $ArchiveDir `
                    $relative
            )
    }
}


# =============================================================================
# MIRROR REMOTE DIRECTORY STRUCTURE
# =============================================================================

function Mirror-RemoteDirectoryStructure {

    # Remote root always needs to exist.
    Ensure-RemoteDirectory `
        -RemoteDirectory $RemoteRoot


    if (-not $MirrorEmptyDirectories) {
        return
    }


    $directories = Get-ChildItem `
        -LiteralPath $IncomingDir `
        -Directory `
        -Recurse `
        -ErrorAction Stop


    foreach ($directory in $directories) {

        $relative = Get-RelativePath `
            -FullPath $directory.FullName `
            -BasePath $IncomingDir


        $remoteDirectory = Get-RemotePath `
            -RelativePath $relative


        Ensure-RemoteDirectory `
            -RemoteDirectory $remoteDirectory
    }
}


# =============================================================================
# CLAIM READY FILES
#
# Incoming -> Processing
# =============================================================================

function Move-ReadyFilesToProcessing {

    $success = $true


    $incomingFiles = Get-ChildItem `
        -LiteralPath $IncomingDir `
        -File `
        -Filter $FileFilter `
        -Recurse `
        -ErrorAction Stop


    foreach ($file in $incomingFiles) {


        # ---------------------------------------------------------------------
        # File still being produced.
        # ---------------------------------------------------------------------

        if (-not (Test-FileReady -File $file)) {

            Write-Log (
                "Leaving '$($file.FullName)' in Incoming; " +
                "file is too new, too small, or still in use."
            )

            continue
        }


        $originalRelativePath = Get-RelativePath `
            -FullPath $file.FullName `
            -BasePath $IncomingDir


        $relativePath = $originalRelativePath


        $processingPath = Join-Path `
            $ProcessingDir `
            $relativePath

        $archivePath = Join-Path `
            $ArchiveDir `
            $relativePath

        $statePath = Get-StatePath `
            -RelativePath $relativePath


        # ---------------------------------------------------------------------
        # Local collision.
        #
        # Rename ONLY if a duplicate actually exists.
        # ---------------------------------------------------------------------

        if (
            (Test-Path -LiteralPath $processingPath) -or
            (Test-Path -LiteralPath $archivePath) -or
            (Test-Path -LiteralPath $statePath)
        ) {

            $timestamp = Get-Date `
                -Format "yyyyMMdd_HHmmssfff"

            $attempt = 0


            do {

                $relativePath = New-DuplicateRelativePath `
                    -RelativePath $originalRelativePath `
                    -Timestamp $timestamp `
                    -Attempt $attempt


                $processingPath = Join-Path `
                    $ProcessingDir `
                    $relativePath

                $archivePath = Join-Path `
                    $ArchiveDir `
                    $relativePath

                $statePath = Get-StatePath `
                    -RelativePath $relativePath


                $attempt++

            } while (
                (Test-Path -LiteralPath $processingPath) -or
                (Test-Path -LiteralPath $archivePath) -or
                (Test-Path -LiteralPath $statePath)
            )


            Write-Log (
                "Local duplicate detected for " +
                "'$originalRelativePath'. " +
                "New file renamed to '$relativePath'."
            ) -Level "WARN"
        }


        # ---------------------------------------------------------------------
        # Move Incoming -> Processing
        # ---------------------------------------------------------------------

        try {

            Ensure-LocalParentDirectory `
                -Path $processingPath


            Move-Item `
                -LiteralPath $file.FullName `
                -Destination $processingPath `
                -ErrorAction Stop


            Write-Log (
                "Claimed: '$($file.FullName)' -> " +
                "'$processingPath'"
            )
        }
        catch {

            Write-Log (
                "Failed moving '$($file.FullName)' to Processing: " +
                $_.Exception.Message
            ) -Level "ERROR"

            $success = $false
        }
    }


    return $success
}


# =============================================================================
# PROCESS ONE QUEUED FILE
#
# Processing -> SFTP -> Archive
# =============================================================================

function Process-QueuedFile {
    param (
        [Parameter(Mandatory)]
        [System.IO.FileInfo]$File
    )


    $relativePath = Get-RelativePath `
        -FullPath $File.FullName `
        -BasePath $ProcessingDir


    # =========================================================================
    # CHECK PREVIOUS UPLOAD STATE
    # =========================================================================

    try {

        $state = Get-UploadState `
            -RelativePath $relativePath
    }
    catch {

        Write-Log `
            $_.Exception.Message `
            -Level "ERROR"

        return $false
    }


    if ($null -ne $state) {


        # ---------------------------------------------------------------------
        # Previous execution was interrupted during upload.
        # ---------------------------------------------------------------------

        if ($state.Status -eq "Uploading") {

            try {

                $remoteExists = Test-RemoteFileExists `
                    -RemoteFilePath $state.RemotePath


                if ($remoteExists) {

                    Write-Log (
                        "Recovered interrupted transfer state for " +
                        "'$relativePath'; remote file exists."
                    )


                    Set-UploadState `
                        -RelativePath $relativePath `
                        -Status "Uploaded" `
                        -RemotePath $state.RemotePath


                    $state = Get-UploadState `
                        -RelativePath $relativePath
                }
                else {

                    # Previous transfer never reached the remote destination.
                    Remove-UploadState `
                        -RelativePath $relativePath

                    $state = $null
                }
            }
            catch {

                Write-Log (
                    "Unable to recover upload state for " +
                    "'$relativePath': " +
                    $_.Exception.Message
                ) -Level "ERROR"

                return $false
            }
        }
        elseif ($state.Status -ne "Uploaded") {

            Write-Log (
                "Unknown transfer state '$($state.Status)' for " +
                "'$relativePath'."
            ) -Level "ERROR"

            return $false
        }
    }


    # =========================================================================
    # FILE HAS NOT YET BEEN CONFIRMED UPLOADED
    # =========================================================================

    if ($null -eq $state) {


        # ---------------------------------------------------------------------
        # Ensure remote parent directory exists.
        # ---------------------------------------------------------------------

        $remoteDirectoryRelative = Split-Path `
            -Parent `
            $relativePath


        if ([string]::IsNullOrWhiteSpace(
            $remoteDirectoryRelative
        )) {

            $remoteDirectory = $RemoteRoot
        }
        else {

            $remoteDirectory = Get-RemotePath `
                -RelativePath $remoteDirectoryRelative
        }


        try {

            Ensure-RemoteDirectory `
                -RemoteDirectory $remoteDirectory
        }
        catch {

            Write-Log (
                "Unable to create/verify remote directory for " +
                "'$relativePath': " +
                $_.Exception.Message
            ) -Level "ERROR"

            return $false
        }


        # ---------------------------------------------------------------------
        # Determine target paths.
        # ---------------------------------------------------------------------

        $archivePath = Join-Path `
            $ArchiveDir `
            $relativePath


        $remotePath = Get-RemotePath `
            -RelativePath $relativePath


        # ---------------------------------------------------------------------
        # Check remote duplicate.
        # ---------------------------------------------------------------------

        try {

            $remoteExists = Test-RemoteFileExists `
                -RemoteFilePath $remotePath
        }
        catch {

            Write-Log (
                "Unable to check remote duplicate for " +
                "'$relativePath': " +
                $_.Exception.Message
            ) -Level "ERROR"

            return $false
        }


        # ---------------------------------------------------------------------
        # Duplicate found either remotely or locally in Archive.
        #
        # Rename Processing copy, then use that SAME name on SFTP and Archive.
        # ---------------------------------------------------------------------

        if (
            $remoteExists -or
            (Test-Path -LiteralPath $archivePath)
        ) {

            $originalRelativePath = $relativePath

            $timestamp = Get-Date `
                -Format "yyyyMMdd_HHmmssfff"

            $attempt = 0


            do {

                $candidateRelativePath =
                    New-DuplicateRelativePath `
                        -RelativePath $originalRelativePath `
                        -Timestamp $timestamp `
                        -Attempt $attempt


                $candidateProcessingPath = Join-Path `
                    $ProcessingDir `
                    $candidateRelativePath


                $candidateArchivePath = Join-Path `
                    $ArchiveDir `
                    $candidateRelativePath


                $candidateStatePath = Get-StatePath `
                    -RelativePath $candidateRelativePath


                $candidateRemotePath = Get-RemotePath `
                    -RelativePath $candidateRelativePath


                $attempt++


                # -------------------------------------------------------------
                # Local collision on candidate.
                # -------------------------------------------------------------

                if (
                    (Test-Path -LiteralPath $candidateProcessingPath) -or
                    (Test-Path -LiteralPath $candidateArchivePath) -or
                    (Test-Path -LiteralPath $candidateStatePath)
                ) {

                    $candidateRemoteExists = $true

                    continue
                }


                # -------------------------------------------------------------
                # Remote collision on candidate.
                # -------------------------------------------------------------

                try {

                    $candidateRemoteExists =
                        Test-RemoteFileExists `
                            -RemoteFilePath $candidateRemotePath
                }
                catch {

                    Write-Log (
                        "Unable to verify duplicate candidate " +
                        "'$candidateRelativePath': " +
                        $_.Exception.Message
                    ) -Level "ERROR"

                    return $false
                }

            } while ($candidateRemoteExists)


            # -----------------------------------------------------------------
            # Rename the Processing copy.
            # -----------------------------------------------------------------

            try {

                Ensure-LocalParentDirectory `
                    -Path $candidateProcessingPath


                Move-Item `
                    -LiteralPath $File.FullName `
                    -Destination $candidateProcessingPath `
                    -ErrorAction Stop


                Write-Log (
                    "Duplicate detected for '$originalRelativePath'. " +
                    "Processing file renamed to " +
                    "'$candidateRelativePath'."
                ) -Level "WARN"


                $relativePath = $candidateRelativePath

                $File = Get-Item `
                    -LiteralPath $candidateProcessingPath `
                    -ErrorAction Stop


                $remotePath  = $candidateRemotePath
                $archivePath = $candidateArchivePath
            }
            catch {

                Write-Log (
                    "Unable to rename duplicate " +
                    "'$originalRelativePath': " +
                    $_.Exception.Message
                ) -Level "ERROR"

                return $false
            }
        }


        # =========================================================================
        # RECORD UPLOAD INTENT
        # =========================================================================

        try {

            Set-UploadState `
                -RelativePath $relativePath `
                -Status "Uploading" `
                -RemotePath $remotePath
        }
        catch {

            Write-Log (
                "Unable to create upload state for " +
                "'$relativePath': " +
                $_.Exception.Message
            ) -Level "ERROR"

            return $false
        }


        Write-Log (
            "Beginning SFTP upload: " +
            "'$relativePath' -> '$remotePath'"
        )


        # =========================================================================
        # UPLOAD
        # =========================================================================

        $uploadSuccess = Send-SftpFile `
            -LocalPath $File.FullName `
            -RemotePath $remotePath


        if (-not $uploadSuccess) {

            Remove-UploadState `
                -RelativePath $relativePath


            Write-Log (
                "Leaving '$relativePath' in Processing for retry."
            ) -Level "WARN"


            return $false
        }


        # =========================================================================
        # RECORD SUCCESS
        # =========================================================================

        try {

            Set-UploadState `
                -RelativePath $relativePath `
                -Status "Uploaded" `
                -RemotePath $remotePath
        }
        catch {

            # Leave Uploading state behind.
            #
            # Next execution will check whether the remote destination exists
            # before deciding whether another upload is required.

            Write-Log (
                "Upload succeeded but state update failed for " +
                "'$relativePath': " +
                $_.Exception.Message
            ) -Level "ERROR"

            return $false
        }


        Write-Log (
            "SFTP upload successful: " +
            "'$relativePath' -> '$remotePath'"
        )
    }


    # =========================================================================
    # UPLOAD CONFIRMED
    #
    # Processing -> Archive
    # =========================================================================

    $archivePath = Join-Path `
        $ArchiveDir `
        $relativePath


    # This should not normally occur because duplicate checks happened before
    # uploading.
    #
    # Do NOT rename here. SFTP already contains the exact relative filename,
    # so changing only Archive would break the mirror relationship.
    if (Test-Path -LiteralPath $archivePath) {

        Write-Log (
            "Upload completed but Archive destination already exists " +
            "unexpectedly: '$archivePath'. " +
            "Leaving Processing file in place."
        ) -Level "ERROR"

        return $false
    }


    try {

        Ensure-LocalParentDirectory `
            -Path $archivePath


        Move-Item `
            -LiteralPath $File.FullName `
            -Destination $archivePath `
            -ErrorAction Stop


        Remove-UploadState `
            -RelativePath $relativePath


        Write-Log (
            "Archived: Processing\$relativePath -> " +
            "Archive\$relativePath"
        )


        return $true
    }
    catch {

        # Upload state remains "Uploaded".
        #
        # Next execution retries only the Archive operation.

        Write-Log (
            "Upload succeeded but Archive move failed for " +
            "'$relativePath': " +
            $_.Exception.Message
        ) -Level "ERROR"


        return $false
    }
}


# =============================================================================
# RETENTION CLEANUP
# =============================================================================

function Remove-ExpiredFiles {

    $success = $true

    $cutoff = (Get-Date).AddDays(
        -$CleanupDays
    )


    # =========================================================================
    # ARCHIVE FILES
    # =========================================================================

    try {

        $expiredArchiveFiles = Get-ChildItem `
            -LiteralPath $ArchiveDir `
            -File `
            -Recurse `
            -ErrorAction Stop |
        Where-Object {
            $_.LastWriteTime -lt $cutoff
        }


        foreach ($file in $expiredArchiveFiles) {

            try {

                Write-Log (
                    "Deleting expired Archive file: " +
                    "'$($file.FullName)'"
                )


                Remove-Item `
                    -LiteralPath $file.FullName `
                    -Force `
                    -ErrorAction Stop
            }
            catch {

                Write-Log (
                    "Unable to delete expired Archive file " +
                    "'$($file.FullName)': " +
                    $_.Exception.Message
                ) -Level "ERROR"

                $success = $false
            }
        }
    }
    catch {

        Write-Log (
            "Archive cleanup failed: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $success = $false
    }


    # =========================================================================
    # LOG FILES
    # =========================================================================

    try {

        $expiredLogs = Get-ChildItem `
            -LiteralPath $LogDir `
            -File `
            -ErrorAction Stop |
        Where-Object {
            $_.LastWriteTime -lt $cutoff
        }


        foreach ($log in $expiredLogs) {

            try {

                Remove-Item `
                    -LiteralPath $log.FullName `
                    -Force `
                    -ErrorAction Stop
            }
            catch {

                Write-Log (
                    "Unable to delete expired logfile " +
                    "'$($log.FullName)': " +
                    $_.Exception.Message
                ) -Level "ERROR"

                $success = $false
            }
        }
    }
    catch {

        Write-Log (
            "Log cleanup failed: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $success = $false
    }


    # =========================================================================
    # ORPHANED STATE FILES
    #
    # State files are only deleted when:
    #
    #   - They are older than CleanupDays
    #   - Their corresponding Processing file no longer exists
    #
    # State for an actual queued file is NEVER cleaned automatically.
    # =========================================================================

    try {

        $oldStateFiles = Get-ChildItem `
            -LiteralPath $StateDir `
            -File `
            -Recurse `
            -Filter "*.uploadstate.json" `
            -ErrorAction Stop |
        Where-Object {
            $_.LastWriteTime -lt $cutoff
        }


        foreach ($stateFile in $oldStateFiles) {

            $stateRelative = Get-RelativePath `
                -FullPath $stateFile.FullName `
                -BasePath $StateDir


            $suffix = ".uploadstate.json"


            if ($stateRelative.EndsWith(
                $suffix,
                [System.StringComparison]::OrdinalIgnoreCase
            )) {

                $processingRelative =
                    $stateRelative.Substring(
                        0,
                        $stateRelative.Length - $suffix.Length
                    )


                $processingPath = Join-Path `
                    $ProcessingDir `
                    $processingRelative


                if (-not (Test-Path -LiteralPath $processingPath)) {

                    Remove-Item `
                        -LiteralPath $stateFile.FullName `
                        -Force `
                        -ErrorAction SilentlyContinue
                }
            }
        }
    }
    catch {

        Write-Log (
            "Transfer-state cleanup failed: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $success = $false
    }


    return $success
}


# =============================================================================
# INITIALIZE LOCAL DIRECTORIES
# =============================================================================

foreach ($directory in @(
    $ScannerRoot,
    $IncomingDir,
    $ProcessingDir,
    $ArchiveDir,
    $LogDir,
    $StateDir
)) {

    Ensure-LocalDirectory `
        -Path $directory
}


# =============================================================================
# CONFIGURATION VALIDATION
# =============================================================================

if (-not (Test-Path -LiteralPath $WinSCPPath -PathType Leaf)) {

    Write-Log `
        "WinSCP executable not found: '$WinSCPPath'" `
        -Level "ERROR"

    exit 2
}


if (-not (Test-Path -LiteralPath $WinSCPIniPath -PathType Leaf)) {

    Write-Log `
        "WinSCP INI not found: '$WinSCPIniPath'" `
        -Level "ERROR"

    exit 2
}


if (-not $RemoteRoot.StartsWith("/")) {

    Write-Log `
        "RemoteRoot must be an absolute SFTP path: '$RemoteRoot'" `
        -Level "ERROR"

    exit 2
}


if ($CleanupDays -lt 1) {

    Write-Log `
        "CleanupDays must be at least 1." `
        -Level "ERROR"

    exit 2
}


if ($MinimumFileAgeSeconds -lt 0) {

    Write-Log `
        "MinimumFileAgeSeconds cannot be negative." `
        -Level "ERROR"

    exit 2
}


# =============================================================================
# INSTANCE LOCK
# =============================================================================

$lockHandle = $null

$hadErrors = $false


try {

    try {

        $lockHandle = New-Object System.IO.FileStream(
            $LockFile,
            [System.IO.FileMode]::OpenOrCreate,
            [System.IO.FileAccess]::ReadWrite,
            [System.IO.FileShare]::None
        )
    }
    catch {

        Write-Log `
            "Another ScannerTransfer instance is already running. Exiting." `
            -Level "WARN"

        exit 0
    }


    Write-Log `
        "========== Scanner transfer run started =========="


    # =========================================================================
    # STEP 1
    #
    # Mirror Incoming directory structure locally.
    # =========================================================================

    try {

        Mirror-LocalDirectoryStructure
    }
    catch {

        Write-Log (
            "Unable to mirror local directory structure: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $hadErrors = $true
    }


    # =========================================================================
    # STEP 2
    #
    # Incoming -> Processing
    # =========================================================================

    try {

        $claimSuccess =
            Move-ReadyFilesToProcessing


        if (-not $claimSuccess) {
            $hadErrors = $true
        }
    }
    catch {

        Write-Log (
            "Unable to process Incoming queue: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $hadErrors = $true
    }


    # =========================================================================
    # STEP 3
    #
    # Mirror directory structure to SFTP.
    # =========================================================================

    try {

        Mirror-RemoteDirectoryStructure
    }
    catch {

        # We still continue.
        #
        # Completed local files are safe in Processing and can retry next run.

        Write-Log (
            "Unable to mirror remote directory structure: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $hadErrors = $true
    }


    # =========================================================================
    # STEP 4
    #
    # Processing -> SFTP -> Archive
    # =========================================================================

    try {

        $processingFiles = Get-ChildItem `
            -LiteralPath $ProcessingDir `
            -File `
            -Filter $FileFilter `
            -Recurse `
            -ErrorAction Stop |
        Sort-Object LastWriteTime


        foreach ($file in $processingFiles) {

            try {

                $fileSuccess =
                    Process-QueuedFile `
                        -File $file


                if (-not $fileSuccess) {
                    $hadErrors = $true
                }
            }
            catch {

                Write-Log (
                    "Unexpected processing error for " +
                    "'$($file.FullName)': " +
                    $_.Exception.Message
                ) -Level "ERROR"

                $hadErrors = $true
            }
        }
    }
    catch {

        Write-Log (
            "Unable to enumerate Processing queue: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $hadErrors = $true
    }


    # =========================================================================
    # STEP 5
    #
    # Retention cleanup.
    # =========================================================================

    try {

        $cleanupSuccess =
            Remove-ExpiredFiles


        if (-not $cleanupSuccess) {
            $hadErrors = $true
        }
    }
    catch {

        Write-Log (
            "Unexpected cleanup error: " +
            $_.Exception.Message
        ) -Level "ERROR"

        $hadErrors = $true
    }


    # =========================================================================
    # FINISH
    # =========================================================================

    if ($hadErrors) {

        Write-Log `
            "Scanner transfer run completed WITH ERRORS."
    }
    else {

        Write-Log `
            "Scanner transfer run completed successfully."
    }


    Write-Log `
        "=================================================="
}
catch {

    Write-Log (
        "Unexpected fatal error: " +
        $_.Exception.Message
    ) -Level "ERROR"

    $hadErrors = $true
}
finally {

    if ($null -ne $lockHandle) {
        $lockHandle.Dispose()
    }
}


# =============================================================================
# TASK SCHEDULER EXIT CODE
# =============================================================================

if ($hadErrors) {
    exit 1
}

exit 0
